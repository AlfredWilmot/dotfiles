#!/usr/bin/env bash

# disallow unset vars, exit on error, propagate errors through pipes
set -ue -o pipefail

SEARCHDIR="${PWD}"
PATTERN=""
REPLACEMENT=""
MAX_PROCS=4

usage() {
  echo "Usage: $(basename "${0}") [OPTION]... PATTERN REPLACEMENT" 2>&1
  echo "Find and replace text in files." 2>&1
  echo "" 2>&1
  echo "OPTIONS:" 2>&1
  echo "  -f, --file   <comma-separated-file-types> (default: all non-binary files)" 2>&1
  echo "  -d, --dir    <search-directory>           (default: current dir)" 2>&1
  echo "" 2>&1
  echo "EXAMPLE: change -f rs,md,py,c -d src/ ^.*let get" 2>&1
  exit 1
}

while [ "${#}" -gt 1 ]; do
  case "${1}" in
    # what file-types should be modified?
    -f | --files)
      _IFS="${IFS}"
      IFS=,
      read -ra FILES <<< "${2}"
      for file in "${FILES[@]}"; do
        CMD+="--include='*.${file}' "
      done
      IFS="${_IFS}"
      shift; shift
      ;;
   # what dir should we look in for those files?
    -d | --dir)
      SEARCHDIR="${2}"
      shift; shift
      ;;
    -h | --help)
      usage
      ;;
    *)
      PATTERN="${1}"
      REPLACEMENT="${2}"
      shift; shift
      ;;
  esac
done
[ "${PATTERN}" == "" ] && usage

# grep opts: recursive, non-binary, list-files, extended-regex
# NOTE: ANSI colors for grep messes-up piping filenames
declare GREP="grep -RIlE --color=never  '${PATTERN}' ${SEARCHDIR} "
GRN=$'\033[1;32m'
RED=$'\033[1;31m'
NC=$'\033[0m' # No Color
PREVIEW=(
  "printf '\n%s [${RED}${PATTERN}${NC} --> ${GRN}${REPLACEMENT}${NC}]\n' {}; "
  "sed -n 's@${PATTERN}@${GRN}${REPLACEMENT}${NC}@g p' {}; "
)
# NOTE: use single process for first xarg call to keep preview output coherent
PREVIEW_CMD="${GREP} | xargs -I {} sh -c \"${PREVIEW[*]}\" "
echo "${PREVIEW_CMD}" 1>&2
eval "${PREVIEW_CMD}"

read -rp "Proceed?" ANS
case "${ANS}" in
  y|Y|[Yy][eE][sS])
    eval "${GREP} | xargs -P ${MAX_PROCS} -I {} sed -i 's/${PATTERN}/${REPLACEMENT}/g' {}"
    echo "Done" 1>&2
    ;;
  *)
    echo "Fine, suit yourself!" 1>&2
    ;;
esac
